cc_binary {
    name: "android.hardware.biometrics.face-service.m2391",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.face-service.m2391.rc"],
    vintf_fragments: ["android.hardware.biometrics.face-service.m2391.xml"],
    srcs: [
        "CameraCapture.cpp",
        "FaceSession.cpp",
        "main.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    shared_libs: [
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.face-V5-ndk",
        "android.hardware.biometrics.face@1.0",
        "android.hardware.common-V2-ndk",
        "android.hardware.keymaster-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libcamera2ndk_vendor",
        "libhidlbase",
        "liblog",
        "libmediandk",
        "libnativewindow",
        "libutils",
        "vendor.xingji.hardware.biometrics.face@1.0",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}
