runtime_resource_overlay {
    name: "M2391TetheringOverlay",
    certificate: "platform",
    product_specific: true,
    sdk_version: "current",
}

override_runtime_resource_overlay {
    name: "M2391TetheringOverlayGoogle",
    base: "M2391TetheringOverlay",
    package_name: "org.lineageos.overlay.m2391.tethering.google",
    target_package_name: "com.google.android.networkstack.tethering",
}
