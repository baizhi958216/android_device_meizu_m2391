# SPDX-License-Identifier: Apache-2.0
# MEIZU additions to the Qualcomm SM8550 source policy.
# Ported from firmware 1764145455; compiled with native SELinux build rules.

allow hal_secure_store_default hal_secure_store_default_exec:file { read getattr map execute open entrypoint };
allow hal_secure_store_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_secure_store_default ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_secure_store_default vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_secure_store_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_secure_store_default hal_secure_store_hwservice:hwservice_manager { add find };
allow hal_secure_store_default hidl_base_hwservice:hwservice_manager { add };
allow hal_secure_store_default property_socket:sock_file { write };
allow hal_secure_store_default init:unix_stream_socket { connectto };
allow hal_secure_store_default vendor_secure_store_prop:property_service { set };
allow hal_secure_store_default vendor_secure_store_prop:file { read getattr map open };
