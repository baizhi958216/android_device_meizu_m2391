type hal_secure_store_default, domain;
type hal_secure_store_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_secure_store_default)
set_prop(hal_secure_store_default, vendor_secure_store_prop)
hal_server_domain(hal_secure_store_default, hal_secure_store)

allow hal_secure_store_default tee_device:chr_file rw_file_perms;
allow hal_secure_store_default ion_device:chr_file rw_file_perms;
allow hal_secure_store_default vendor_dmabuf_qseecom_heap_device:chr_file rw_file_perms;
allow hal_secure_store_default vendor_dmabuf_qseecom_ta_heap_device:chr_file rw_file_perms;
allow hal_secure_store_default hal_secure_store_hwservice:hwservice_manager { add find };
allow hal_secure_store_default hidl_base_hwservice:hwservice_manager { add };
