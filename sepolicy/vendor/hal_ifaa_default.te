type hal_ifaa_default, domain;
type hal_ifaa_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_ifaa_default)
set_prop(hal_ifaa_default, vendor_ifaa_prop)
hal_server_domain(hal_ifaa_default, hal_ifaa)

allow hal_ifaa_default tee_device:chr_file rw_file_perms;
allow hal_ifaa_default ion_device:chr_file rw_file_perms;
allow hal_ifaa_default vendor_dmabuf_qseecom_heap_device:chr_file rw_file_perms;
allow hal_ifaa_default vendor_dmabuf_qseecom_ta_heap_device:chr_file rw_file_perms;
allow hal_ifaa_default hal_ifaa_hwservice:hwservice_manager { add find };
allow hal_ifaa_default hidl_base_hwservice:hwservice_manager { add };
