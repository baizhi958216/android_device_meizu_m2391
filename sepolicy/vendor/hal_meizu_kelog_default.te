type hal_meizu_kelog_default, domain;
type hal_meizu_kelog_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_meizu_kelog_default)
set_prop(hal_meizu_kelog_default, vendor_meizu_kelog_prop)
hal_server_domain(hal_meizu_kelog_default, hal_meizu_kelog)

allow hal_meizu_kelog_default hal_meizu_kelog_hwservice:hwservice_manager { add find };
allow hal_meizu_kelog_default hidl_base_hwservice:hwservice_manager { add };
allow hal_meizu_kelog_default sysfs_rstinfo_file:file rw_file_perms;
allow hal_meizu_kelog_default proc_rstinfo_file:file rw_file_perms;
allow hal_meizu_kelog_default xmkelog_data_file:file rw_file_perms;
allow hal_meizu_kelog_default xmkelog_data_file:file create_file_perms;
allow hal_meizu_kelog_default xmkelog_data_file:dir { ioctl read write getattr lock append map open watch watch_reads };
allow hal_meizu_kelog_default xmkelog_data_file:dir { create add_name remove_name search rmdir };
allow hal_meizu_kelog_default proc_reset_reason:file r_file_perms;
allow hal_meizu_kelog_default block_device:dir r_dir_perms;
allow hal_meizu_kelog_default block_device:blk_file { getattr };
allow hal_meizu_kelog_default vendor_rawdump_block_device:dir r_dir_perms;
allow hal_meizu_kelog_default vendor_rawdump_block_device:blk_file { read getattr open };
allow hal_meizu_kelog_default sdcardfs:dir { read write create open add_name remove_name search };
allow hal_meizu_kelog_default sdcardfs:file { read write create getattr append unlink open };
allow hal_meizu_kelog_default storage_file:dir { search };
allow hal_meizu_kelog_default fuse:dir { read write create open add_name remove_name search rmdir };
allow hal_meizu_kelog_default fuse:file { read write create getattr append unlink rename open };
allow hal_meizu_kelog_default storage_file:lnk_file { read };
allow hal_meizu_kelog_default mnt_user_file:lnk_file { read };
allow hal_meizu_kelog_default mnt_user_file:dir { search };
