type hal_fbase_defrag_default, domain;
type hal_fbase_defrag_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_fbase_defrag_default)
hal_server_domain(hal_fbase_defrag_default, hal_fbase_defrag)

allow hal_fbase_defrag_default hal_fbase_defrag_hwservice:hwservice_manager { add find };
allow hal_fbase_defrag_default hidl_base_hwservice:hwservice_manager { add };
