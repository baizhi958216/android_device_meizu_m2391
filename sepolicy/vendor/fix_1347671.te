init_daemon_domain(fix_1347671)

allow fix_1347671 servicemanager:binder { call transfer };
allow fix_1347671 self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow fix_1347671 tee_device:chr_file rw_file_perms;
allow fix_1347671 vendor_dmabuf_qseecom_heap_device:chr_file rw_file_perms;
allow fix_1347671 vendor_file:file rx_file_perms;
allow fix_1347671 vendor_shell_exec:file rx_file_perms;
get_prop(fix_1347671, vendor_tee_listener_prop)
get_prop(fix_1347671, vendor_fix_1347671_prop)

binder_use(fix_1347671)
