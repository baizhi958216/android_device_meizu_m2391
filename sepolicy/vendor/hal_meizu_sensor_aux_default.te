# SPDX-License-Identifier: Apache-2.0

type hal_meizu_sensor_aux_default, domain;
type hal_meizu_sensor_aux_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_meizu_sensor_aux_default)
hal_server_domain(hal_meizu_sensor_aux_default, hal_meizu_sensor_aux)

allow hal_meizu_sensor_aux_default vendor_sysfs_graphics:dir r_dir_perms;
allow hal_meizu_sensor_aux_default vendor_sysfs_graphics:file r_file_perms;
allow hal_meizu_sensor_aux_default mnt_vendor_file:dir r_dir_perms;
allow hal_meizu_sensor_aux_default vendor_persist_sensors_file:dir { search };
allow hal_meizu_sensor_aux_default vendor_persist_sensors_file:file { read getattr open };
allow hal_meizu_sensor_aux_default self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_meizu_sensor_aux_default self:qipcrtr_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allowxperm hal_meizu_sensor_aux_default self:socket ioctl { 0xc300-0xc305 };
allowxperm hal_meizu_sensor_aux_default self:qipcrtr_socket ioctl { 0xc300-0xc305 };
get_prop(hal_meizu_sensor_aux_default, vendor_sensors_prop)
get_prop(hal_meizu_sensor_aux_default, surfaceflinger_color_prop)
