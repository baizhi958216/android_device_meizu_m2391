type hal_fido_default, domain;
type hal_fido_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_fido_default)
set_prop(hal_fido_default, vendor_fido_prop)
hal_server_domain(hal_fido_default, hal_fido)

allow hal_fido_default tee_device:chr_file rw_file_perms;
allow hal_fido_default ion_device:chr_file rw_file_perms;
allow hal_fido_default vendor_dmabuf_qseecom_heap_device:chr_file rw_file_perms;
allow hal_fido_default vendor_dmabuf_qseecom_ta_heap_device:chr_file rw_file_perms;
allow hal_fido_default hal_fido_hwservice:hwservice_manager { add find };
allow hal_fido_default hidl_base_hwservice:hwservice_manager { add };
