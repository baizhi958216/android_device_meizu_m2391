type hal_eid_default, domain, halclientdomain, vendor_hal_qteeconnector_client;
type hal_eid_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_eid_default)
hal_server_domain(hal_eid_default, hal_eid)

allow hal_eid_default tee_device:chr_file { ioctl read write open };
allow hal_eid_default firmware_file:dir r_dir_perms;
allow hal_eid_default firmware_file:file r_file_perms;
allow hal_eid_default firmware_file:lnk_file r_file_perms;
allow hal_eid_default ion_device:chr_file r_file_perms;
get_prop(hal_eid_default, vendor_tee_listener_prop)
allow hal_eid_default vendor_hal_esepowermanager_hwservice:hwservice_manager { find };
allow hal_eid_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read write open };
allow hal_eid_default vendor_hal_esepowermanager_qti:binder { call };
allow hal_eid_default proc_sysrq:file { write lock append map open };
