# SPDX-License-Identifier: Apache-2.0

type hal_meizu_charging_default, domain;
type hal_meizu_charging_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_meizu_charging_default)
hal_server_domain(hal_meizu_charging_default, hal_meizu_charging)

allow hal_meizu_charging_default hal_meizu_charging_hwservice:hwservice_manager { add find };
allow hal_meizu_charging_default hidl_base_hwservice:hwservice_manager { add };
allow hal_meizu_charging_default sysfs_wired_charger:file rw_file_perms;
allow hal_meizu_charging_default sysfs_wireless_charger:file rw_file_perms;
