# Expose the ncm.gs6 function expected by QTI UsbGadget HAL and advertise
# WINNCM in OS descriptors for Windows 10/11 composite ncm,adb compatibility.
on boot
    mkdir /config/usb_gadget/g1/functions/ncm.gs6
    write /config/usb_gadget/g1/functions/ncm.gs6/os_desc/interface.ncm/compatible_id WINNCM
