# SPDX-License-Identifier: Apache-2.0
ro.zygote=zygote64_32
ro.crypto.volume.filenames_mode=aes-256-cts

# Select the stock device camera configuration instead of the two-camera GSI one.
ro.vendor.qti.va_aosp.support=1

# The stock camera HAL stalls on framework-composited JPEG_R capture.
# Ordinary JPEG capture works; do not advertise the synthesized Ultra HDR path.
ro.camera.disableJpegR=true
